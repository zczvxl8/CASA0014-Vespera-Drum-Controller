void storeRealHit(byte drum, int peak, unsigned long now) {
  if (gameMode != GAME_P1_RECORD && gameMode != GAME_P2_RECORD) return;
  int strength = relativeStrength(drum, peak);

  DrumEvent *target;
  int *count;
  unsigned long *firstTime;
  bool *started;
  if (gameMode == GAME_P1_RECORD) {
    target = originalHits;
    count = &originalCount;
    firstTime = &originalFirstTime;
    started = &originalStarted;
  } else {
    target = imitationHits;
    count = &imitationCount;
    firstTime = &imitationFirstTime;
    started = &imitationStarted;
  }

  if (*count >= MAX_EVENTS) {
    if (gameMode == GAME_P1_RECORD) finishPlayer1();
    else finishPlayer2();
    return;
  }

  if (!*started) {
    *started = true;
    *firstTime = now;
  }

  DrumEvent &event = target[*count];
  event.timeMs = now - *firstTime;
  event.peakDelta = peak;
  event.drum = drum;
  event.strength = (byte)strength;
  (*count)++;

  triggerLight(drum, event.strength, now);
  Serial.print(gameMode == GAME_P1_RECORD ? F("[P1 HIT] ") : F("[P2 HIT] "));
  Serial.print(F("Drum "));
  Serial.print(drum + 1);
  Serial.print(F(" t="));
  Serial.print(event.timeMs);
  Serial.print(F("ms strength="));
  Serial.println(strength);

  if (*count >= MAX_EVENTS) {
    Serial.println(F("[WARN] 120 events reached; ending this performance."));
    if (gameMode == GAME_P1_RECORD) finishPlayer1();
    else finishPlayer2();
  }
}

void readRealDrums(unsigned long now) {
  for (byte drum = 0; drum < DRUM_COUNT; ++drum) {
    int raw = analogRead(PIEZO_PINS[drum]);
    int delta = raw - (int)baseline[drum];
    if (delta < 0) delta = -delta;
    int releaseThreshold = HIT_THRESHOLD[drum] * 45 / 100;

    if (!capturing[drum] && delta < releaseThreshold) {
      baseline[drum] = baseline[drum] * 0.998f + raw * 0.002f;
    }

    if (capturing[drum]) {
      if (delta > capturePeak[drum]) capturePeak[drum] = delta;
      if (now - captureStart[drum] >= PEAK_WINDOW_MS) {
        capturing[drum] = false;
        storeRealHit(drum, capturePeak[drum], now);
        hasHit[drum] = true;
        lastRealHit[drum] = now;
        armed[drum] = false;
        quietStart[drum] = 0;
      }
      continue;
    }

    if (!armed[drum]) {
      if (delta <= releaseThreshold) {
        if (quietStart[drum] == 0) quietStart[drum] = now;
        if (now - quietStart[drum] >= REARM_QUIET_MS &&
            now - lastRealHit[drum] >= COOLDOWN_MS) {
          armed[drum] = true;
        }
      } else {
        quietStart[drum] = 0;
      }
      continue;
    }

    if (delta >= HIT_THRESHOLD[drum] &&
        (!hasHit[drum] || now - lastRealHit[drum] >= COOLDOWN_MS)) {
      capturing[drum] = true;
      captureStart[drum] = now;
      capturePeak[drum] = delta;
      armed[drum] = false;
    }
  }
}

void handleSwitchFlip() {
  Serial.println(F("[SWITCH] Stable physical flip detected."));
  switch (gameMode) {
    case GAME_READY: startPlayer1(); break;
    case GAME_P1_RECORD: finishPlayer1(); break;
    case GAME_P1_SAVED: startDemo(); break;
    case GAME_DEMO: demoFinished(false); break;
    case GAME_WAIT_P2: startPlayer2(); break;
    case GAME_P2_RECORD: finishPlayer2(); break;
    case GAME_SCORE: startPlayer1(); break;
  }
}

void pollSwitch(unsigned long now) {
  int value = digitalRead(SWITCH_PIN);
  if (value != rawSwitch) {
    rawSwitch = value;
    rawSwitchChangeAt = now;
  }
  if (rawSwitch != stableSwitch &&
      now - rawSwitchChangeAt >= SWITCH_DEBOUNCE_MS) {
    stableSwitch = rawSwitch;
    handleSwitchFlip();
  }
}

void pollSerial() {
  while (Serial.available() > 0) {
    char command = (char)Serial.read();
    if (command == 'n' || command == 'N') {
      gameMode = GAME_READY;
      originalCount = 0;
      imitationCount = 0;
      originalStarted = false;
      imitationStarted = false;
      finalScore = 0;
      clearLights();
      setNotice("NEW ROUND", "FLIP TO P1");
      Serial.println(F("[TEST] Reset to READY; next flip starts Player 1."));
    }
  }
}

void connectWifi() {
#if defined(SECRET_WIFIUSER) && defined(SECRET_WIFI_CA)
  WiFi.beginEnterprise(WIFI_SSID, SECRET_WIFIUSER, WIFI_PASS,
                       SECRET_WIFIUSER, SECRET_WIFI_CA);
#elif defined(SECRET_WIFIUSER)
  // Without a verified CA, enterprise credentials are not protected
  // against an impostor authentication server. Ask university IT.
  WiFi.beginEnterprise(WIFI_SSID, SECRET_WIFIUSER, WIFI_PASS);
#else
  WiFi.begin(WIFI_SSID, WIFI_PASS);
#endif
}

void maintainNetwork(unsigned long now) {
  if (WiFi.status() != WL_CONNECTED) {
    if (gameMode == GAME_DEMO) {
      gameMode = GAME_P1_SAVED;
      clearLights();
      setNotice("WIFI LOST", "RETRY DEMO");
      Serial.println(F("[DEMO] WiFi lost. Demonstration not completed."));
    }
    if (lastWifiAttempt == 0 || now - lastWifiAttempt >= 10000UL) {
      lastWifiAttempt = now;
      Serial.println(F("[WIFI] Connecting..."));
      connectWifi();
    }
    return;
  }
  if (!mqttClient.connected()) {
    if (gameMode == GAME_DEMO) {
      gameMode = GAME_P1_SAVED;
      clearLights();
      setNotice("MQTT LOST", "RETRY DEMO");
      Serial.println(F("[DEMO] MQTT lost. Demonstration not completed."));
    }
    if (lastMqttAttempt == 0 || now - lastMqttAttempt >= 5000UL) {
      lastMqttAttempt = now;
      Serial.println(F("[MQTT] Connecting..."));
      if (mqttClient.connect(mqttClientId.c_str(), MQTT_USER, MQTT_PASS)) {
        Serial.println(F("[MQTT] Connected, real 72-LED output is ready."));
      } else {
        Serial.print(F("[MQTT] Connection failed, state="));
        Serial.println(mqttClient.state());
      }
    }
    return;
  }
  mqttClient.loop();
}

bool beginOLED() {
  const byte addresses[2] = {0x3C, 0x3D};
  for (byte i = 0; i < 2; ++i) {
    Wire.beginTransmission(addresses[i]);
    if (Wire.endTransmission() != 0) continue;
    if (oled.begin(SSD1306_SWITCHCAPVCC, addresses[i])) {
      Serial.print(F("[OLED] Address=0x"));
      Serial.println(addresses[i], HEX);
      return true;
    }
  }
  Serial.println(F("[OLED] Not found. Serial and lights remain available."));
  return false;
}

