void clearLights() {
  for (byte i = 0; i < DRUM_COUNT; ++i) {
    lit[i] = false;
    litStrength[i] = 0;
    litAt[i] = 0;
  }
  fusionMask = 0;
  fusionFirstTime = 0;
  fusionLatestTime = 0;
  for (int i = 0; i < PAYLOAD_SIZE; ++i) rgbPayload[i] = 0;
}

RGB drumColour(byte drum, float strength) {
  strength = clampUnit(strength);
  if (drum == 0) {
    return {150 + 105 * strength, 65 - 35 * strength,
            245 - 65 * strength};
  }
  if (drum == 1) {
    return {20 + 30 * strength, 165 + 90 * strength,
            255 - 105 * strength};
  }
  return {255, 205 - 125 * strength, 35 + 25 * strength};
}

int countFusionMembers(uint8_t mask) {
  int total = 0;
  for (byte drum = 0; drum < DRUM_COUNT; ++drum) {
    if (mask & (1 << drum)) ++total;
  }
  return total;
}

RGB fusedColour() {
  RGB result = {0, 0, 0};
  float totalWeight = 0;
  for (byte drum = 0; drum < DRUM_COUNT; ++drum) {
    if (!(fusionMask & (1 << drum))) continue;
    RGB c = drumColour(drum, litStrength[drum]);
    float weight = 0.55f + 0.45f * litStrength[drum];
    result.r += c.r * weight;
    result.g += c.g * weight;
    result.b += c.b * weight;
    totalWeight += weight;
  }
  if (totalWeight > 0) {
    result.r /= totalWeight;
    result.g /= totalWeight;
    result.b /= totalWeight;
  }
  return result;
}

void triggerLight(byte drum, byte strength, unsigned long now) {
  lit[drum] = true;
  litStrength[drum] = clampUnit(strength / 100.0f);
  litAt[drum] = now;
  mostRecentDrum = drum + 1;
  mostRecentStrength = strength;

  if (fusionMask == 0 || now - fusionFirstTime > FUSION_MS) {
    fusionMask = (1 << drum);
    fusionFirstTime = now;
  } else {
    fusionMask |= (1 << drum);
  }
  fusionLatestTime = now;
}

void renderLights(unsigned long now) {
  bool fused = countFusionMembers(fusionMask) >= 2 &&
               now - fusionLatestTime < FADE_MS;
  RGB mix = fusedColour();

  for (int pixel = 0; pixel < LED_COUNT; ++pixel) {
    byte drum = pixel / LEDS_PER_DRUM;
    RGB c = {0, 0, 0};
    float brightness = 0;

    if (lit[drum] && now - litAt[drum] < FADE_MS) {
      float fade = 1.0f - (now - litAt[drum]) / (float)FADE_MS;
      c = drumColour(drum, litStrength[drum]);
      brightness = (0.5f + 0.5f * litStrength[drum]) * fade * fade;
    }

    if (fused && (fusionMask & (1 << drum))) {
      float fade = 1.0f - (now - fusionLatestTime) / (float)FADE_MS;
      c = mix;
      brightness = (0.55f + 0.45f * litStrength[drum]) * fade * fade;
    }

    rgbPayload[pixel * 3 + 0] = clampByte(c.r * brightness);
    rgbPayload[pixel * 3 + 1] = clampByte(c.g * brightness);
    rgbPayload[pixel * 3 + 2] = clampByte(c.b * brightness);
  }
}

int relativeStrength(byte drum, int peak) {
  int low = HIT_THRESHOLD[drum];
  int high = STRONG_PEAK[drum];
  if (high <= low) high = low + 1;
  long result = 1L + (long)(peak - low) * 99L / (high - low);
  if (result < 1) result = 1;
  if (result > 100) result = 100;
  return (int)result;
}

// Pair similarity: 50% drum identity, 30% relative timing,
// 20% relative strength. Timing is measured from each first hit.
int pairCost(const DrumEvent &a, const DrumEvent &b) {
  if (a.drum != b.drum) return 100;

  unsigned long difference = a.timeMs > b.timeMs ?
      a.timeMs - b.timeMs : b.timeMs - a.timeMs;
  int timeScore = 0;
  if (difference < TIMING_TOLERANCE_MS) {
    timeScore = 100 -
        (int)(difference * 100UL / TIMING_TOLERANCE_MS);
  }

  int strengthDifference = (int)a.strength - (int)b.strength;
  if (strengthDifference < 0) strengthDifference = -strengthDifference;
  int strengthScore = 100 - strengthDifference;

  int similarity = 50 + (30 * timeScore + 20 * strengthScore) / 100;
  return 100 - similarity;
}

int calculateImitationScore() {
  if (originalCount == 0 || imitationCount == 0) return 0;

  // Levenshtein-style alignment with weighted substitution costs.
  // Missing or extra event = cost 100; correct events cost 0..50.
  for (int j = 0; j <= imitationCount; ++j) {
    scorePrevious[j] = j * 100;
  }

  for (int i = 1; i <= originalCount; ++i) {
    scoreCurrent[0] = i * 100;

    for (int j = 1; j <= imitationCount; ++j) {
      uint16_t substitution = scorePrevious[j - 1] +
          pairCost(originalHits[i - 1], imitationHits[j - 1]);
      uint16_t missing = scorePrevious[j] + 100;
      uint16_t extra = scoreCurrent[j - 1] + 100;

      uint16_t best = substitution;
      if (missing < best) best = missing;
      if (extra < best) best = extra;
      scoreCurrent[j] = best;
    }

    for (int j = 0; j <= imitationCount; ++j) {
      scorePrevious[j] = scoreCurrent[j];
    }
  }

  int longest = originalCount > imitationCount ?
      originalCount : imitationCount;
  unsigned long denominator = (unsigned long)longest * 100UL;
  unsigned long cost = scorePrevious[imitationCount];
  if (cost >= denominator) return 0;

  unsigned long result = 100UL -
      (cost * 100UL + denominator / 2UL) / denominator;
  if (result > 100UL) result = 100UL;
  return (int)result;
}

void startPlayer1() {
  if (!mqttClient.connected()) {
    Serial.println(F("[ERROR] MQTT offline: cannot begin a visible game."));
    setNotice("MQTT OFFLINE", "TRY AGAIN");
    return;
  }

  originalCount = 0;
  imitationCount = 0;
  originalStarted = false;
  imitationStarted = false;
  finalScore = 0;
  demoIndex = 0;
  mostRecentDrum = -1;
  mostRecentStrength = 0;
  clearLights();
  gameMode = GAME_P1_RECORD;
  setNotice("PLAYER 1", "RECORDING");
  Serial.println(F("[P1] Recording started. Play a short rhythm."));
}

void finishPlayer1() {
  if (gameMode != GAME_P1_RECORD) return;
  if (originalCount == 0) {
    gameMode = GAME_READY;
    setNotice("NO P1 HITS", "TRY AGAIN");
    Serial.println(F("[P1] No recorded hits; next flip can try again."));
    return;
  }
  gameMode = GAME_P1_SAVED;
  setNotice("PLAYER 1", "SAVED");
  Serial.print(F("[P1] Saved original hits="));
  Serial.print(originalCount);
  Serial.print(F(" duration="));
  Serial.print(originalHits[originalCount - 1].timeMs);
  Serial.println(F("ms from first to last hit."));
  Serial.println(F("[P1] Flip to demonstrate the ORIGINAL via actual lights."));
}

void startDemo() {
  if (originalCount == 0) {
    Serial.println(F("[DEMO] No original rhythm stored."));
    return;
  }
  if (!mqttClient.connected()) {
    setNotice("MQTT OFFLINE", "NO DEMO");
    Serial.println(F("[DEMO] Cannot replay: MQTT is disconnected."));
    return;
  }

  gameMode = GAME_DEMO;
  demoIndex = 0;
  demoStartTime = millis();
  clearLights();
  setNotice("WATCH", "DEMO");
  Serial.println(F("[DEMO] Started REAL light replay, first hit at t=0ms."));
}

void demoFinished(bool completed) {
  if (gameMode != GAME_DEMO) return;
  clearLights();
  gameMode = GAME_WAIT_P2;
  setNotice(completed ? "DEMO DONE" : "DEMO SKIP", "P2 NEXT");
  Serial.println(completed ?
      F("[DEMO] Completed. Player 2 can now start.") :
      F("[DEMO] Skipped by switch. Player 2 can now start."));
}

void updateDemo(unsigned long now) {
  if (gameMode != GAME_DEMO) return;
  if (!mqttClient.connected()) {
    gameMode = GAME_P1_SAVED;
    clearLights();
    setNotice("MQTT LOST", "RETRY DEMO");
    Serial.println(F("[DEMO] Stopped on network loss; replay not complete."));
    return;
  }

  unsigned long elapsed = now - demoStartTime;
  while (demoIndex < originalCount &&
         elapsed >= originalHits[demoIndex].timeMs) {
    const DrumEvent &hit = originalHits[demoIndex];
    triggerLight(hit.drum, hit.strength, now);
    Serial.print(F("[DEMO HIT] Drum "));
    Serial.print(hit.drum + 1);
    Serial.print(F(" t="));
    Serial.print(hit.timeMs);
    Serial.print(F("ms strength="));
    Serial.println(hit.strength);
    demoIndex++;
  }

  if (demoIndex == originalCount &&
      elapsed >= originalHits[originalCount - 1].timeMs + FADE_MS) {
    demoFinished(true);
  }
}

