void drawOLED(unsigned long now) {
  if (!oledReady) return;
  oled.clearDisplay();
  oled.setTextSize(1);
  oled.setTextColor(SSD1306_WHITE);
  oled.drawLine(91, 0, 91, 63, SSD1306_WHITE);

  // The numeric score is intentionally NEVER masked by a notice.
  if (gameMode == GAME_SCORE) {
    oled.setCursor(0, 4);
    oled.print(F("FINAL SCORE"));
    oled.setTextSize(2);
    oled.setCursor(0, 19);
    oled.print(finalScore);
    oled.setTextSize(1);
    oled.print(F("/100"));
    oled.setCursor(0, 47);
    oled.print(F("P1:"));
    oled.print(originalCount);
    oled.print(F(" P2:"));
    oled.print(imitationCount);
  } else if (noticeActive && now - noticeStart < NOTICE_MS) {
    oled.setCursor(0, 8);
    oled.print(noticeLine1);
    oled.setCursor(0, 26);
    oled.print(noticeLine2);
  } else {
    oled.setCursor(0, 3);
    switch (gameMode) {
      case GAME_READY: oled.print(F("READY")); break;
      case GAME_P1_RECORD: oled.print(F("P1 RECORD")); break;
      case GAME_P1_SAVED: oled.print(F("P1 SAVED")); break;
      case GAME_DEMO: oled.print(F("WATCH DEMO")); break;
      case GAME_WAIT_P2: oled.print(F("P2 READY")); break;
      case GAME_P2_RECORD: oled.print(F("P2 IMITATE")); break;
      case GAME_SCORE: break;
    }

    oled.setCursor(0, 19);
    oled.print(F("P1:"));
    oled.print(originalCount);
    oled.print(F(" P2:"));
    oled.print(imitationCount);

    oled.setCursor(0, 34);
    if (gameMode == GAME_DEMO) {
      oled.print(F("EVENT:"));
      oled.print(demoIndex);
    } else if (mostRecentDrum > 0) {
      oled.print(F("DRUM "));
      oled.print(mostRecentDrum);
    } else {
      oled.print(F("FLIP SWITCH"));
    }

    oled.setCursor(0, 50);
    if (gameMode == GAME_P1_RECORD || gameMode == GAME_P2_RECORD) {
      oled.print(F("STR: "));
      oled.print(mostRecentStrength);
    } else if (mqttClient.connected()) {
      oled.print(F("MQTT: OK"));
    } else {
      oled.print(F("WAIT MQTT"));
    }
  }
  drawDrumIcon(now);
  oled.display();
}

void setup() {
  Serial.begin(115200);
  unsigned long serialWait = millis();
  while (!Serial && millis() - serialWait < 2500UL) {}

  analogReadResolution(10);
  pinMode(SWITCH_PIN, INPUT_PULLUP);
  rawSwitch = digitalRead(SWITCH_PIN);
  stableSwitch = rawSwitch;

  Serial.println(F("=========================================="));
  Serial.println(F("TEST 07 — TWO-PLAYER RHYTHM IMITATION GAME"));
  Serial.println(F("A0/A1/A2, D2 latching switch, OLED, 72 LED MQTT"));
  Serial.println(F("Keep ALL drums quiet during calibration."));

  for (byte drum = 0; drum < DRUM_COUNT; ++drum) {
    pinMode(PIEZO_PINS[drum], INPUT);
    long sum = 0;
    for (int sample = 0; sample < 100; ++sample) {
      sum += analogRead(PIEZO_PINS[drum]);
      delay(2);
    }
    baseline[drum] = sum / 100.0f;
  }

  Wire.begin();
  Wire.setClock(400000UL);
  oledReady = beginOLED();

  byte mac[6] = {0};
  WiFi.macAddress(mac);
  char suffix[13];
  snprintf(suffix, sizeof(suffix), "%02X%02X%02X%02X%02X%02X",
           mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
  mqttClientId = String("CASA0014_Test07_") + suffix;
  mqttClient.setServer(MQTT_SERVER, MQTT_PORT);
  if (!mqttClient.setBufferSize(512)) {
    Serial.println(F("[ERROR] Cannot allocate MQTT 512-byte buffer."));
  }
  mqttClient.setKeepAlive(30);
  mqttClient.setSocketTimeout(2);

  clearLights();
  setNotice("READY", "WAIT MQTT");
  Serial.println(F("Wait for MQTT Connected before starting Player 1."));
  Serial.println(F("Switch: P1 REC -> P1 SAVE -> DEMO -> P2 REC -> SCORE -> NEW ROUND"));
  Serial.println(F("Serial: 'n' resets the game (test convenience only)."));
}

void loop() {
  unsigned long now = millis();
  readRealDrums(now);
  pollSwitch(now);
  pollSerial();
  maintainNetwork(now);
  updateDemo(now);

  if (now - lastLightFrame >= LIGHT_FRAME_MS) {
    lastLightFrame = now;
    if (mqttClient.connected()) {
      renderLights(now);
      if (!mqttClient.publish(LIGHT_TOPIC, rgbPayload, PAYLOAD_SIZE)) {
        Serial.println(F("[MQTT] Lighting publish failed."));
        if (gameMode == GAME_DEMO) {
          gameMode = GAME_P1_SAVED;
          clearLights();
          setNotice("SEND FAILED", "RETRY DEMO");
          Serial.println(F("[DEMO] Not completed: light publish failed."));
        }
      }
    }
  }

  if (now - lastOledFrame >= OLED_FRAME_MS) {
    lastOledFrame = now;
    drawOLED(now);
  }
}
